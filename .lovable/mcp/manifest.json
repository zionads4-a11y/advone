      {
        "name": "list_leads",
        "title": "Listar leads",
        "description": "Lista leads do CRM do escritório, com filtros por coluna do funil, status, score, busca por nome/telefone e paginação. Respeita as permissões do usuário conectado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "company_id": {
              "description": "Escritório. Se omitido, usa o primeiro acessível.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "kanban_column_id": {
              "description": "Filtra por coluna do funil.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "status": {
              "description": "Filtra por status do lead (ex: new, contacted, won, lost).",
              "type": "string"
            },
            "lead_score": {
              "description": "Filtra pela temperatura do lead.",
              "type": "string",
              "enum": [
                "hot",
                "warm",
                "cold"
              ]
            },
            "only_unread": {
              "description": "Apenas leads com mensagem não lida.",
              "type": "boolean"
            },
            "search": {
              "description": "Busca parcial por nome ou telefone.",
              "type": "string"
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "offset": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
